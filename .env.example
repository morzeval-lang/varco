# Copia in .env.local e compila. Senza chiavi l'app gira in modalità demo.

# Claude come Game Master (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Modello opzionale, default claude-opus-5-5
VARCO_CLAUDE_MODEL=

# Segreto del server per i semi dei dadi (una stringa lunga a caso)
VARCO_DICE_SECRET=cambiami

# Generatore d'immagini per i ritratti dei giocatori (opzionale: senza, resta la figura disegnata dal codice)
OPENAI_API_KEY=
# Modello opzionale, default gpt-image-1
VARCO_IMMAGINI_MODELLO=

# Database per le stanze multigiocatore (Supabase). Senza, le stanze stanno nella memoria del server:
# va bene in locale, ma online si perdono. Vedi docs/pubblicare.md.
SUPABASE_URL=
# La chiave segreta del progetto (Settings → API Keys → Secret key, inizia con sb_secret_). Mai nel browser.
SUPABASE_SECRET_KEY=
